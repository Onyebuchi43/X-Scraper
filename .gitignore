# Ignore packaging metadata
*.egg-info/
dist/
build/

# Python cache/bytecode
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/

# Local state DBs (examples/runtime artifacts)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local secrets (never commit real tokens/passwords)
/.env

# Runtime output artifacts
outputs/
dashboard/uploads/
dashboard/generated_images/
*.log
*.png
!assets/*.png
elonmusk_followers.json

# Ignore IDE settings
.idea/
.vscode/

# Ignore stale files inside Scweet/
Scweet/debug.log

# Not tracked in v5:
src/
tools/
